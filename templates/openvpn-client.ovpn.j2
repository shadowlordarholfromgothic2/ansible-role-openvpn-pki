# OpenVPN profile for "{{ item.name }}", generated by the openvpn_pki role.
# It contains the client's private key - keep it secret.
client
dev tun
{# udp/tcp let the client use IPv4 or IPv6, whatever the name resolves to #}
proto {{ openvpn_pki_proto | regex_replace('6$', '') }}
remote {{ openvpn_pki_remote }} {{ openvpn_pki_port }}
resolv-retry infinite
nobind
persist-key
persist-tun
# Only accept the server's certificate - not another client's.
remote-cert-tls server
verify-x509-name {{ openvpn_pki_server_name }} name
{% if (openvpn_pki_auth | string) not in ['', 'None'] %}
auth {{ openvpn_pki_auth }}
{% endif %}
{% if (openvpn_pki_key_direction | string) not in ['', 'None'] %}
key-direction {{ openvpn_pki_key_direction }}
{% endif %}
verb 3

<ca>
{{ lookup('ansible.builtin.file', openvpn_pki_dir ~ '/ca.crt') }}
</ca>
<cert>
{{ lookup('ansible.builtin.file', openvpn_pki_dir ~ '/issued/' ~ item.name ~ '.crt') }}
</cert>
<key>
{{ lookup('ansible.builtin.file', openvpn_pki_dir ~ '/private/' ~ item.name ~ '.key') }}
</key>
<tls-crypt>
{{ lookup('ansible.builtin.file', openvpn_pki_dir ~ '/private/tls-crypt.key') }}
</tls-crypt>
